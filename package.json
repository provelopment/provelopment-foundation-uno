{
  "name": "provelopment-foundation-uno",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Foundation Uno — independent single-Entity Next.js / TypeScript website foundation. U01 technical baseline only.",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:bootstrap": "node --test tests/bootstrap.test.mjs && node scripts/verify-bootstrap.mjs",
    "test:http": "node scripts/verify-u01-http.mjs",
    "test:architecture": "node --test tests/architecture/u01-boundaries.test.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "next": "16.4.2",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "playwright": "1.65.1",
    "typescript": "5.9.3",
    "vite": "8.2.4",
    "vitest": "4.1.12"
  }
}
