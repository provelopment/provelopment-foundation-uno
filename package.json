{
  "name": "provelopment-foundation-uno",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Foundation Uno \u2014 independent single-Entity Next.js / TypeScript website foundation. U01 technical baseline only.",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit --exclude \"**/.temp/**\"",
    "test:bootstrap": "node --test tests/bootstrap.test.mjs && node scripts/verify-bootstrap.mjs",
    "test:http": "node scripts/verify-u01-http.mjs",
    "test:architecture": "node --test tests/architecture/u01-boundaries.test.mjs",
    "test:distribution": "node scripts/verify-u06-distribution.mjs",
    "test:boundaries": "node scripts/verify-uno-module-boundaries.mjs --self-test && node scripts/verify-uno-module-boundaries.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "next": "16.4.6",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.6",
    "@types/node": "26.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/parser": "8.74.0",
    "eslint": "9.39.5",
    "eslint-import-resolver-node": "0.3.10",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "playwright": "1.65.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.2.4",
    "vitest": "4.1.12"
  }
}
