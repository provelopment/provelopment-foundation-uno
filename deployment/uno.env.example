# Foundation Uno — contact mail transport (placeholder configuration)
#
# This file contains NO real value. Every entry is a placeholder. Copy it into your hosting provider's secret store or
# an ignored local file, fill it there, and never commit the filled copy.
#
# Contact delivery is OFF unless UNO_CONTACT_TRANSPORT names a transport. Read
# `.documents/Architecture/connect-mail.md` before enabling anything.

# ---------------------------------------------------------------------------
# Transport selection. Leave EMPTY to keep delivery off.
#   offline  — non-transmitting demonstration: the whole path runs, nothing is sent
#   resend   — one direct attempt through the Resend API
# ---------------------------------------------------------------------------
UNO_CONTACT_TRANSPORT=

# ---------------------------------------------------------------------------
# Resend (only read when UNO_CONTACT_TRANSPORT=resend)
# ---------------------------------------------------------------------------
# A dedicated, domain-restricted, sending-only key. Created in the Resend dashboard, stored only here.
RESEND_API_KEY=FILL_IN

# The verified sender. It MUST belong to one of the domains below.
UNO_CONTACT_FROM=FILL_IN <noreply@mail.example.com>

# Server-allowlisted recipients, comma separated, maximum five. A visitor can never add one.
UNO_CONTACT_TO=FILL_IN@example.com

# The verified sending domains the sender must belong to, comma separated.
UNO_CONTACT_FROM_DOMAINS=FILL_IN.example.com

# ---------------------------------------------------------------------------
# Private delivery policy (server only, independent of every public contact fact)
# ---------------------------------------------------------------------------
# Where an enquiry is delivered, who it appears to come from, and whether a Reply-To is used. None of these values is
# ever rendered, logged or returned to a visitor. A Site can publish a mailto without any of this, and can enable a form
# without publishing any address.
UNO_CONTACT_RECIPIENT=FILL_IN@example.com
UNO_CONTACT_SENDER=noreply@mail.example.com
UNO_CONTACT_SENDER_DOMAINS=FILL_IN.example.com
# visitor | none
UNO_CONTACT_REPLY_TO=visitor

# ---------------------------------------------------------------------------
# Explicit form enablement and placement (all three are required; none is implied)
# ---------------------------------------------------------------------------
# A form exists only when an operator enables it, names the exact Site it serves, and names the exact Page whose own
# declared form may submit. A contact property never enables a form.
UNO_CONTACT_FORM_ENABLED=
UNO_CONTACT_FORM_SITE=foundation/main
UNO_CONTACT_FORM_PAGE=FILL_IN
