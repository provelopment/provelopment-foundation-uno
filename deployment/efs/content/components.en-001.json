{
  "version": 1,
  "title": "Components",
  "description": "A small sample of the text-only building blocks an authored JSON Page can use, followed by seventeen bounded samples of the Foundation family compositions.",
  "visibility": "public",
  "sections": [
    {
      "id": "components-intro",
      "module": "content.heading",
      "props": { "text": "A sample of authored sections", "level": 2 }
    },
    {
      "id": "components-copy",
      "module": "content.prose",
      "props": {
        "text": "A JSON Page is an ordered list of validated sections. The modules on this Page are already implemented and render as plain, accessible text."
      }
    },
    {
      "id": "components-list",
      "module": "content.prose",
      "props": {
        "variant": "list",
        "items": [
          { "label": "Heading and prose", "detail": "Authored titles and paragraphs." },
          { "label": "Native list", "detail": "Ordered or unordered text entries." },
          { "label": "Disclosure group", "detail": "Platform details and summary elements." }
        ]
      }
    },
    {
      "id": "components-stack",
      "module": "layout.stack",
      "props": {},
      "children": [
        {
          "id": "components-stack-heading",
          "module": "content.heading",
          "props": { "text": "Keyboard-accessible disclosure", "level": 3 }
        },
        {
          "id": "components-stack-copy",
          "module": "content.prose",
          "props": {
            "text": "The disclosure group below uses native details and summary elements, so it needs no script, provider or network request."
          }
        }
      ]
    },
    {
      "id": "components-faq",
      "module": "interaction.accordion",
      "props": {
        "items": [
          { "sectionId": "components-faq-answer-0", "label": "Does this Page contact a server?" },
          { "sectionId": "components-faq-answer-1", "label": "Is any provider involved?" }
        ]
      },
      "children": [
        {
          "id": "components-faq-answer-0",
          "module": "content.prose",
          "props": { "text": "No. The disclosure is rendered by the browser from the authored document." }
        },
        {
          "id": "components-faq-answer-1",
          "module": "content.prose",
          "props": { "text": "No provider, analytics event or external request is part of this sample." }
        }
      ]
    },
    {
      "id": "components-callout",
      "module": "content.prose",
      "props": {
        "variant": "callout",
        "text": "This Page demonstrates a selection of modules. It does not claim that every registered module is used here.",
        "tone": "note"
      }
    },
    {
      "id": "family-0-prose",
      "module": "layout.stack",
      "props": {},
      "children": [
        {
          "id": "family-0-prose-heading",
          "module": "content.heading",
          "props": {
            "text": "Bounded family samples",
            "level": 2
          }
        },
        {
          "id": "family-0-prose-lede",
          "module": "content.prose",
          "props": {
            "text": "These seventeen compositions are appended after the six native sections above."
          }
        },
        {
          "id": "family-0-prose-prose",
          "module": "content.prose",
          "props": {
            "text": "Every sample on this Page is an original Uno-authored demonstration of one bounded donor family. Each one is plain text with no styling control and no provider."
          }
        }
      ]
    },
    {
      "id": "family-1-callout",
      "module": "content.prose",
      "props": {
        "variant": "callout",
        "text": "A callout carries authored plain text only. Its accent belongs to the renderer, not to this source.",
        "tone": "note"
      }
    },
    {
      "id": "family-2-list",
      "module": "content.prose",
      "props": {
        "variant": "list",
        "items": [
          {
            "label": "Authored order",
            "detail": "The composed sections keep their source order."
          },
          {
            "label": "One stable identity",
            "detail": "Each family keeps its generated top-level id."
          },
          {
            "label": "Plain text",
            "detail": "No Markdown, link or rich text is accepted here."
          }
        ],
        "ordered": true
      }
    },
    {
      "id": "family-3-faq",
      "module": "interaction.accordion",
      "props": {
        "items": [
          {
            "sectionId": "family-3-faq-answer-0",
            "label": "Does a disclosure need a script?"
          },
          {
            "sectionId": "family-3-faq-answer-1",
            "label": "Can an answer carry markup?"
          }
        ]
      },
      "children": [
        {
          "id": "family-3-faq-answer-0",
          "module": "content.prose",
          "props": {
            "text": "No. The group uses the platform details and summary elements."
          }
        },
        {
          "id": "family-3-faq-answer-1",
          "module": "content.prose",
          "props": {
            "text": "No. Answers are authored plain text only."
          }
        }
      ]
    },
